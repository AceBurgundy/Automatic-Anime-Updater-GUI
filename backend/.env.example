# Path to local unwatched anime directory
TARGET_DIR=D:\Videos\Anime Unwatched

# Audio Preference: "sub" (default), "dub", "sub_strict", "dub_strict"
AUDIO_PREFERENCE=sub

# Download posters automatically (true/false)
DOWNLOAD_POSTERS=true

# AI Model Download URL (defaults to Qwen 2.5 0.5B GGUF)
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_FILENAME=qwen2.5-0.5b-instruct-q4_k_m.gguf

# Scheduled Automation Times (comma-separated, 24h format)
SCHEDULE_TIMES=06:00,12:00,22:00

# Temporary directory for in-progress video downloads (defaults to Windows %TEMP%\anime-refresher if blank)
TEMP_DIR=

# Animepahe mirror URLs (comma-separated, auto-failover order)
BASE_URLS=https://animepahe.pw,https://animepahe.ru,https://animepahe.org,https://animepahe.com

# Local Ollama Model (Optional fallback)
OLLAMA_MODEL=gemma_2B_basic
OLLAMA_HOST=http://localhost:11434

# Resolution Fallback Settings
FALLBACK_MAX_RETRIES=3

# Rate limiting throttle between episode processing (in seconds)
REQUEST_DELAY_SECONDS=60

# Headless mode for Playwright browser (true/false)
HEADLESS=true
